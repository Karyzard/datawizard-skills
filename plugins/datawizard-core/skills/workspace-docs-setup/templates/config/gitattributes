# Cross-platform line-ending normalization (Windows + macOS parity)
# Default: normalize all text files to LF in the repo, auto-detect on checkout.
* text=auto eol=lf

# Documentation & AI artifacts — always LF
*.md       text eol=lf
*.markdown text eol=lf
*.mdc      text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf

# Shell scripts must stay LF even on Windows checkout
*.sh       text eol=lf

# Windows-only scripts need CRLF to run correctly
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Treat common binaries as binary (no EOL or diff munging)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.docx binary
*.xlsx binary
*.pptx binary
