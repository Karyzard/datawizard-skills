# EditorConfig — consistent files across Windows + macOS editors
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (hard line breaks) but enforce LF + UTF-8
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Windows scripts use CRLF
[*.{ps1,bat,cmd}]
end_of_line = crlf
